{
  "name": "tiny-sword-survivors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tiny Sword Survivors — bullet-heaven роглайт на нативном Phaser 4 для Yandex Games",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:yg": "vite build && node scripts/build-archive.mjs",
    "check:yg": "node scripts/build-archive.mjs --check",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
