generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Результаты матчей Tiny Sword Survivors
model GameResult {
  id            Int      @id @default(autoincrement())
  name          String
  score         Int
  kills         Int
  level         Int
  timeSurvived  Int // секунды
  victory       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([score])
}
